# Die beiden MCP-Server (Higgsfield, KI-Kennzeichnung) laufen über OAuth im
# Browser. Dafür ist hier kein Key nötig.

# Nur für die Render-Route über fal.ai (`/render --provider fal`).
# Key holen: fal.ai/dashboard/keys
FAL_KEY=

# Optional, nur wenn du Wettbewerber-Ads automatisch aus der Meta Ad Library
# ziehen willst statt sie von Hand einzugeben:
# APIFY_TOKEN=
